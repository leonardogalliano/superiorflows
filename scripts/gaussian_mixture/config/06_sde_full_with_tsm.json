{
    "target": {
        "d": 2,
        "a": 2.875,
        "sigma2_max": 0.2,
        "sigma2_min": 0.01,
        "weight": 0.6666666666666666
    },
    "training": {
        "nsteps": 5000,
        "batch_size": 128,
        "seed": 0,
        "loss_type": "stochastic_interpolant",
        "log_freq": 250,
        "ckpt_path": "tmp/ckpt_benchmark/06_sde_full_with_tsm",
        "overwrite": true,
        "num_checkpoints": 1
    },
    "optimizer": {
        "type": "adam",
        "lr_schedule": "1e-3",
        "clip": null
    },
    "velocity": {
        "type": "mlp",
        "width": 64,
        "depth": 3,
        "time_embedding_dim": 0
    },
    "solver": {
        "type": "tsit5",
        "atol": 1e-05,
        "rtol": 1e-05,
        "solver_steps": 100
    },
    "stochastic_interpolant": {
        "interpolant_scheduler": "t",
        "noise_scheduler": "0.5 * (1-t) * t",
        "learn_denoiser": true,
        "denoiser_weight": 1.0,
        "denoiser_only": false,
        "tsm_weight": 1.0
    },
    "sde": {
        "noise_schedule": "1.0",
        "noise_ratio": null,
        "steps": 100
    },
    "callbacks": {
        "ess": {
            "enabled": false,
            "freq": 500,
            "samples": 1000
        },
        "tensorboard": {
            "enabled": false,
            "freq": 100,
            "log_dir": "tmp/tb_logs"
        }
    }
}
